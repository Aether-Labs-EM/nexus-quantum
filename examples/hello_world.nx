# ==========================================
# Nexus Language - "Hello World" (Bell State)
# Compiler: Vector 1.0
# ==========================================

algo hello_quantum(q1, q2) {
    # 1. מכניסים את הקיוביט הראשון לסופרפוזיציה
    H(q1).
    
    # 2. שוזרים את הקיוביט השני לראשון 
    q1.q2(CNOT).
}

# --- התוכנית הראשית ---

# אתחול זוג קיוביטים מוגנים מפני רעש
my_qubits = qubits(2, protect="Surface").

# הרצת האלגוריתם שלנו על הקיוביטים שהקצינו
hello_quantum(my_qubits[0], my_qubits[1]).

# שליחת התוצאה למדידה
my_qubits -> out.