# ==========================================
# Nexus Language - "Hello World" (Bell State)
# Compiler: Vector 1.0
# ==========================================

algo:
hello_quantum(q1, q2) {
    # הגדרת עומק מקסימלי למעגל
    P = 2.
    
    # 1. מכניסים את הקיוביט הראשון לסופרפוזיציה
    H(q1).
    
    # 2. שוזרים את הקיוביט השני לראשון 
    # (q1 שולט ב-q2)
    q1.q2(CNOT).
}

# --- התוכנית הראשית ---

# אתחול זוג קיוביטים מוגנים מפני רעש
my_qubits = qubits(2, state=0, protect="Surface").

# הרצת הפייפליין: אלגוריתם -> מעבד -> תוצאה!
hello_quantum(my_qubits[0], my_qubits[1]) -> run(1000, "IBM_Brisbane") -> results.

